{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/sensitive_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking sensitive-area guard"
          }
        ]
      }
    ]
  }
}
